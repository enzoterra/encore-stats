# Encore: catálogo de variáveis de ambiente (docs/projeto/03-arquitetura.md).
# Copie para `.env.local` (ignorado pelo git). Tudo pode ficar vazio: sem as
# credenciais do Spotify o modo Conectar fica desabilitado e Upload + Demo funcionam.
# Nunca commite valores reais. Valores só no servidor, exceto os NEXT_PUBLIC_*.

# --- Spotify (modo Conectar) -------------------------------------------------
# Defina as três juntas ou nenhuma (configuração parcial falha na inicialização).
# Crie o app em https://developer.spotify.com/dashboard (passo a passo no README).
SPOTIFY_CLIENT_ID=
# Só no servidor. Nunca exponha em NEXT_PUBLIC_*.
SPOTIFY_CLIENT_SECRET=
# URI exata cadastrada no Spotify, terminando em /api/auth/callback. HTTPS, ou HTTP só em
# loopback fora da Vercel. Local: use 127.0.0.1 (o Spotify não aceita "localhost"):
#   SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback
# A origem dela é onde os cookies de sessão vivem: abra o app nessa mesma origem.
SPOTIFY_REDIRECT_URI=

# --- Sessão (cookie JWE) -----------------------------------------------------
# Obrigatória quando o Spotify está configurado. 32 bytes aleatórios em base64url (43 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Opcional, para rotação: o segredo anterior continua abrindo sessões antigas.
SESSION_SECRET_PREVIOUS=

# --- Site --------------------------------------------------------------------
# URL canônica. Obrigatória em produção; localmente o padrão é http://127.0.0.1:3000.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Opcional: link "veja o código" do selo de privacidade.
NEXT_PUBLIC_REPO_URL=

# --- Mock do Spotify (opcional, só para testes locais/e2e) --------------------
# Trocam as bases da API e do Accounts por um mock (`node scripts/spotify-mock-server.ts`).
# Só aceitam URL de loopback e são PROIBIDAS em deploys da Vercel (a app não sobe).
#   SPOTIFY_ACCOUNTS_BASE=http://127.0.0.1:4010
#   SPOTIFY_API_BASE=http://127.0.0.1:4010/v1
SPOTIFY_ACCOUNTS_BASE=
SPOTIFY_API_BASE=

# VERCEL_ENV é definida pela própria Vercel (development | preview | production); não defina localmente.
